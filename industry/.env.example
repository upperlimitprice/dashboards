# industry/.env 로 복사해서 채우세요 (.env 는 git 에 올라가지 않습니다)

# EIA Open Data — https://www.eia.gov/opendata/register.php (무료, 즉시 발급)
# 사용 페이지: grid, datacenter(전력판매), solar(발전량)
EIA_API_KEY=

# 공공데이터포털 '관세청_품목별 수출입실적' 활용신청 후 "디코딩" 인증키
# https://www.data.go.kr/data/15100475/openapi.do
# 사용 페이지: auto, mlcc_lead, solar(교역)
DATA_GO_KR_KEY=

# SEC EDGAR 는 키 대신 연락처가 담긴 User-Agent 를 요구합니다 ("이름 이메일")
# 사용 페이지: datacenter
SEC_USER_AGENT=

# (선택) 푸시할 브랜치 — 비우면 현재 체크아웃된 브랜치
GIT_BRANCH=
